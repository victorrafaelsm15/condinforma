# ── Frontend (prefixo VITE_) ──────────────────────────────────────────────
# Ficam expostas no bundle do navegador — nunca coloque segredos aqui.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_CHAVE_ANONIMA
VITE_ADMIN_EMAIL=admin@condinforma.com
VITE_ADMIN_PASSWORD=condinforma2026
# Chave PÚBLICA do par VAPID (Web Push) — gerada com "npx web-push
# generate-vapid-keys". A privada NUNCA fica aqui, só nos secrets da Edge
# Function (ver VAPID_PRIVATE_KEY abaixo).
VITE_VAPID_PUBLIC_KEY=SUA_CHAVE_PUBLICA_VAPID

# ── Backend (Supabase Edge Functions, pasta supabase/functions — configure
# via "npx supabase secrets set" ou o painel do Supabase, NUNCA prefixar
# com VITE_) ───────────────────────────────────────────────────────────────
# Se tivessem VITE_, iriam parar no JS do navegador e qualquer pessoa
# conseguiria ler a chave de API do Asaas e a service role key do Supabase.
ASAAS_ENV=sandbox
ASAAS_API_KEY=SUA_CHAVE_DE_API_DO_ASAAS
ASAAS_WEBHOOK_TOKEN=UM_TOKEN_SECRETO_INVENTADO_POR_VOCE
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SUA_CHAVE_SERVICE_ROLE
# Chave da API da Anthropic (Claude), usada pelo bot de suporte (support-chat).
# Obtida em https://console.anthropic.com — nunca prefixar com VITE_.
ANTHROPIC_API_KEY=SUA_CHAVE_DA_API_ANTHROPIC
# Par de chaves VAPID (Web Push), gerado com "npx web-push
# generate-vapid-keys" — VAPID_PUBLIC_KEY deve ser IGUAL à
# VITE_VAPID_PUBLIC_KEY acima. VAPID_SUBJECT é um "mailto:" de contato,
# exigido pelo protocolo Web Push.
VAPID_PUBLIC_KEY=SUA_CHAVE_PUBLICA_VAPID
VAPID_PRIVATE_KEY=SUA_CHAVE_PRIVADA_VAPID
VAPID_SUBJECT=mailto:contato@condinforma.com
